{
    "name":  "sparrow-coming-soon",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev",
                    "build":  "next build",
                    "start":  "next start",
                    "lint":  "eslint .",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run",
                    "test:e2e":  "playwright test",
                    "dev:vinext":  "vite dev --port 3001",
                    "build:vinext":  "vite build",
                    "start:vinext":  "wrangler dev --config dist/server/wrangler.json",
                    "deploy:vinext":  "vinext-cloudflare deploy --config dist/server/wrangler.json"
                },
    "dependencies":  {
                         "@hookform/resolvers":  "^5.2.2",
                         "@radix-ui/react-slot":  "^1.2.3",
                         "@react-three/drei":  "^10.7.6",
                         "@react-three/fiber":  "^9.4.0",
                         "@tailwindcss/postcss":  "^4.1.17",
                         "@vinext/cloudflare":  "^1.3.3",
                         "class-variance-authority":  "^0.7.1",
                         "clsx":  "^2.1.1",
                         "gsap":  "^3.13.0",
                         "lenis":  "^1.3.13",
                         "motion":  "^12.23.24",
                         "next":  "^15.5.6",
                         "postcss":  "8.5.32",
                         "posthog-js":  "^1.285.0",
                         "posthog-node":  "^5.13.3",
                         "react":  "^19.1.1",
                         "react-dom":  "^19.1.1",
                         "react-hook-form":  "^7.66.0",
                         "react-server-dom-webpack":  "^19.3.1",
                         "resend":  "^6.1.2",
                         "tailwind-merge":  "^3.3.1",
                         "vinext":  "^1.4.4",
                         "zod":  "^4.1.12"
                     },
    "devDependencies":  {
                            "@axe-core/playwright":  "^4.10.2",
                            "@cloudflare/vite-plugin":  "^1.67.0",
                            "@playwright/test":  "^1.56.1",
                            "@types/node":  "^24.10.0",
                            "@types/react":  "^19.2.2",
                            "@types/react-dom":  "^19.2.2",
                            "@vitejs/plugin-react":  "^6.2.1",
                            "@vitejs/plugin-rsc":  "^0.5.39",
                            "eslint":  "^9.39.1",
                            "eslint-config-next":  "^15.5.6",
                            "prettier":  "^3.6.2",
                            "tailwindcss":  "^4.1.17",
                            "typescript":  "^5.9.3",
                            "vite":  "^8.3.6",
                            "vitest":  "^4.0.8",
                            "wrangler":  "^4.158.0"
                        },
    "type":  "module",
    "overrides":  {
                      "postcss":  "$postcss",
                      "satori":  {
                                     "fflate":  "0.7.5"
                                 }
                  }
}